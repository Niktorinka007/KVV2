<Window x:Class="KVV2.Windows.Avtorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KVV2.Windows"
        mc:Ignorable="d"
        Title="Avtorization" Height="331" Width="730">
    <Grid>
        <Label Content="Логин" HorizontalAlignment="Left" Margin="50,72,0,0" VerticalAlignment="Top"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="50,120,0,0" VerticalAlignment="Top"/>
        <TextBox Name="TbPass"  HorizontalAlignment="Left" Margin="138,124,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="TbLogin" HorizontalAlignment="Left" Margin="138,76,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="BtnLogin"  Content="Войти" HorizontalAlignment="Left" Margin="50,177,0,0" VerticalAlignment="Top" Height="29" Width="208"/>
        <Label Content="Собери капчу" HorizontalAlignment="Left" Margin="361,32,0,0" VerticalAlignment="Top"/>
        <Border Tag="1" Width="50" Height="50" Background="LightGray" AllowDrop="True" DragEnter="Border_DragEnter" DragLeave="Border_DragLeave" Drop="Border_Drop" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="361,76,0,0"/>
        <Border Tag="2" Width="50" Height="50" Background="LightGray" AllowDrop="True" DragEnter="Border_DragEnter" DragLeave="Border_DragLeave" Drop="Border_Drop" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="411,76,0,0"/>
        <Border Tag="3" Width="50" Height="50" Background="LightGray" AllowDrop="True" DragEnter="Border_DragEnter" DragLeave="Border_DragLeave" Drop="Border_Drop" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="361,126,0,0"/>
        <Border Tag="4" Width="50" Height="50" Background="LightGray" AllowDrop="True" DragEnter="Border_DragEnter" DragLeave="Border_DragLeave" Drop="Border_Drop" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="411,126,0,0"/>
        <Image Tag="1" Source="/Recources/Capcha/1.png" Stretch="Fill" VerticalAlignment="Top" HorizontalAlignment="Left" Width="50" Height="50" Margin="551,76,0,0" />
        <Image Tag="2" Source="/Recources/Capcha/2.png" Stretch="Fill" VerticalAlignment="Top" HorizontalAlignment="Left" Width="50" Height="50" Margin="551,126,0,0" />
        <Image Tag="3" Source="/Recources/Capcha/3.png" Stretch="Fill" VerticalAlignment="Top" HorizontalAlignment="Left" Width="50" Height="50" Margin="501,126,0,0" />
        <Image Tag="4" Source="/Recources/Capcha/4.png" Stretch="Fill" VerticalAlignment="Top" HorizontalAlignment="Left" Width="50" Height="50" Margin="501,76,0,0" />
    </Grid>
</Window>
